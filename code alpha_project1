import streamlit as st
from googletrans import Translator, LANGUAGES

st.set_page_config(page_title="AI Translator", page_icon="🌐")
st.title("🌐 Language Translation Tool - CodeAlpha")
translator = Translator()
lang_list = list(LANGUAGES.values())
lang_codes = list(LANGUAGES.keys())
text = st.text_area("Enter text to translate:", height=150)
col1, col2 = st.columns(2)
with col1:
    src = st.selectbox("From", ["auto"] + lang_list)
with col2:
    dest = st.selectbox("To", lang_list, index=21)
if st.button("Translate"):
    if text:
        src_code = 'auto' if src == 'auto' else lang_codes[lang_list.index(src)]
        dest_code = lang_codes[lang_list.index(dest)]
        result = translator.translate(text, src=src_code, dest=dest_code)
        st.success("Translated Text:")
        st.write(result.text)